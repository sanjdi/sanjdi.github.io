{"componentChunkName":"component---src-pages-projects-contentful-project-sku-js","path":"/projects/google-doc-2-json/","result":{"data":{"contentfulProject":{"id":"28266668-46f4-5e99-95d1-f2bf8b80c089","title":"Google Doc 2 Json","introduction":"A utility designed to extract structured data from <table></table> tags in publicly accessible Google Docs","price":0,"description":{"raw":"{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"The \",\"nodeType\":\"text\"},{\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Google Doc Table Data Extraction Tool\",\"nodeType\":\"text\"},{\"data\":{},\"marks\":[],\"value\":\" is a utility designed to extract structured data from <table></table> tags in publicly accessible Google Docs. It simplifies the process of retrieving tabular information embedded within a Google Doc, making it easy to convert data for further analysis or integration into other systems.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"},{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Key Features:\",\"nodeType\":\"text\"}],\"nodeType\":\"heading-4\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Access Public Google Docs\",\"nodeType\":\"text\"},{\"data\":{},\"marks\":[],\"value\":\":\\nThe tool can access and extract data from tables in any publicly shared Google Doc, requiring no manual copy-pasting.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Extract Tabular Data\",\"nodeType\":\"text\"},{\"data\":{},\"marks\":[],\"value\":\":\\nIt targets and extracts data specifically from <table></table> tags, preserving the structure of rows and columns to ensure accuracy.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Automatic Data Parsing\",\"nodeType\":\"text\"},{\"data\":{},\"marks\":[],\"value\":\":\\nThe extracted data is automatically parsed into a structured format, such as CSV, JSON, or Excel, for easy use in other applications.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[{\"type\":\"bold\"}],\"value\":\"Seamless Integration\",\"nodeType\":\"text\"},{\"data\":{},\"marks\":[],\"value\":\":\\nThe tool integrates effortlessly with other data processing workflows, enabling smooth transitions from document-based tables to analytics, databases, or reporting systems.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"}],\"nodeType\":\"ordered-list\"},{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Benefits:\",\"nodeType\":\"text\"}],\"nodeType\":\"heading-4\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Saves time by automatically extracting table data without manual intervention.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Converts Google Doc tables into usable formats for analysis or further processing.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"},{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"Useful for researchers, data analysts, or anyone working with large amounts of tabular data stored in public Google Docs.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"list-item\"}],\"nodeType\":\"unordered-list\"},{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"This tool is perfect for efficiently extracting and repurposing tabular data from publicly shared documents.\",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"}"},"headerImage":{"gatsbyImageData":{"images":{"sources":[{"srcSet":"https://images.ctfassets.net/za7ob9p4awk0/2tpu0R1a7trTsDUHbkBwoq/2f1de72bd8f6e114a955afc3081ef9ae/GoogleDocToJson.jpeg?w=256&h=256&q=50&fm=webp 256w,\nhttps://images.ctfassets.net/za7ob9p4awk0/2tpu0R1a7trTsDUHbkBwoq/2f1de72bd8f6e114a955afc3081ef9ae/GoogleDocToJson.jpeg?w=512&h=512&q=50&fm=webp 512w,\nhttps://images.ctfassets.net/za7ob9p4awk0/2tpu0R1a7trTsDUHbkBwoq/2f1de72bd8f6e114a955afc3081ef9ae/GoogleDocToJson.jpeg?w=1024&h=1024&q=50&fm=webp 1024w","sizes":"(min-width: 1024px) 1024px, 100vw","type":"image/webp"},{"srcSet":"https://images.ctfassets.net/za7ob9p4awk0/2tpu0R1a7trTsDUHbkBwoq/2f1de72bd8f6e114a955afc3081ef9ae/GoogleDocToJson.jpeg?w=256&h=256&q=50&fm=avif 256w,\nhttps://images.ctfassets.net/za7ob9p4awk0/2tpu0R1a7trTsDUHbkBwoq/2f1de72bd8f6e114a955afc3081ef9ae/GoogleDocToJson.jpeg?w=512&h=512&q=50&fm=avif 512w,\nhttps://images.ctfassets.net/za7ob9p4awk0/2tpu0R1a7trTsDUHbkBwoq/2f1de72bd8f6e114a955afc3081ef9ae/GoogleDocToJson.jpeg?w=1024&h=1024&q=50&fm=avif 1024w","sizes":"(min-width: 1024px) 1024px, 100vw","type":"image/avif"}],"fallback":{"src":"https://images.ctfassets.net/za7ob9p4awk0/2tpu0R1a7trTsDUHbkBwoq/2f1de72bd8f6e114a955afc3081ef9ae/GoogleDocToJson.jpeg?w=1024&h=1024&fl=progressive&q=50&fm=jpg","srcSet":"https://images.ctfassets.net/za7ob9p4awk0/2tpu0R1a7trTsDUHbkBwoq/2f1de72bd8f6e114a955afc3081ef9ae/GoogleDocToJson.jpeg?w=256&h=256&fl=progressive&q=50&fm=jpg 256w,\nhttps://images.ctfassets.net/za7ob9p4awk0/2tpu0R1a7trTsDUHbkBwoq/2f1de72bd8f6e114a955afc3081ef9ae/GoogleDocToJson.jpeg?w=512&h=512&fl=progressive&q=50&fm=jpg 512w,\nhttps://images.ctfassets.net/za7ob9p4awk0/2tpu0R1a7trTsDUHbkBwoq/2f1de72bd8f6e114a955afc3081ef9ae/GoogleDocToJson.jpeg?w=1024&h=1024&fl=progressive&q=50&fm=jpg 1024w","sizes":"(min-width: 1024px) 1024px, 100vw"}},"layout":"constrai